@echo off
chcp 65001 >nul
title Nikkah Management System - Update Live App
cls
echo ========================================================
echo        نکاح مینجمنٹ سسٹم - لائیو اپڈیٹ ٹول
echo ========================================================
echo.
echo [1/3] نئی اور تبدیل شدہ فائلز شامل کی جا رہی ہیں...
git add .

echo [2/3] تبدیلیوں کو محفوظ کیا جا رہا ہے...
git commit -m "Auto Update %date% %time%" 2>nul || echo کوئی نئی لوکل تبدیلی موجود نہیں تھی۔

echo [3/3] گٹ ہب اور ورسل پر ڈیٹا بھیجا جا رہا ہے...
git push

echo.
echo ========================================================
if %ERRORLEVEL% EQU 0 (
    echo   ماشاءاللہ! تمام تبدیلیاں کامیابی سے لائیو ہو چکی ہیں! 🚀
    echo   ورسل (Vercel) پر ۳۰ سیکنڈ میں نئی سائٹ فعال ہو جائے گی۔
) else (
    echo   کچھ مسئلہ آیا ہے، براہ کرم انٹرنیٹ یا ایرر چیک کریں۔
)
echo ========================================================
echo.
pause
